# Browser cooking tries Puter first. This key is the server fallback only:
# Space Bunny Alpha, then OPENROUTER_MODEL.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Signs Auth.js JWT sessions for the Expo app (credentials sign-in / sign-up).
# The website also accepts its own sf_user cookie without this secret.
AUTH_SECRET=

# Postgres connection string (Neon or any Postgres). Required on Vercel:
# the fallback file database does not survive serverless isolates.
# Leave unset locally to use a PGlite database on disk.
DATABASE_URL=

# Directory for the local PGlite database when DATABASE_URL is unset.
# Defaults to .data/seedfeast
SEEDFEAST_DATA_DIR=

# Stripe subscription checkout. Without it, checkout returns 503 and
# subscription status stays at the value stored on the account.
STRIPE_SECRET_KEY=

# Comma-separated browser origins allowed to call the API with cookies.
# Example: https://seed-feast.vercel.app
CORS_ORIGINS=

# Expo / React Native app. Prefix for relative /api fetches when the app
# is not served from the same origin as this backend.
# Example: https://seed-feast.vercel.app
EXPO_PUBLIC_API_URL=
